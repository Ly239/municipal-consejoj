{% extends 'base.html' %}

{% block content %}
<div class="container py-5">
    <!-- Header de la sección -->
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="fw-bold text-primary">{{ page_title|default:"Listado Institucional" }}</h1>
            {% if page_subtitle %}
                <p class="text-muted lead fs-6">{{ page_subtitle }}</p>
            {% endif %}
            <hr class="w-25 mx-auto mt-2">
        </div>
    </div>

    <!-- Grid de Tarjetas -->
    {% if object_list %}
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            {% for object in object_list %}
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden transition-hover">
                        <!-- Imagen de la tarjeta (si existe) -->
                        {% if object.image %}
                            <div class="position-relative" style="height: 200px; overflow: hidden;">
                                <img src="{{ object.image.url }}" class="w-100 h-100 object-fit-cover" alt="{{ object.title }}">
                                {% if object.is_featured %}
                                    <span class="position-absolute top-0 end-0 m-3 badge bg-warning text-dark shadow-sm">
                                        <i class="bi bi-star-fill me-1"></i> Destacado
                                    </span>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="height: 200px;">
                                <i class="bi bi-image fs-1 opacity-50"></i>
                            </div>
                        {% endif %}

                        <div class="card-body d-flex flex-column p-4">
                            <!-- Fecha u otro metadato -->
                            {% if object.publication_date %}
                                <small class="text-muted mb-2">
                                    <i class="bi bi-calendar3 me-1"></i> {{ object.publication_date|date:"d M, Y" }}
                                </small>
                            {% elif object.start_date %}
                                <small class="text-muted mb-2">
                                    <i class="bi bi-calendar-event me-1"></i> {{ object.start_date|date:"d M, Y" }}
                                </small>
                            {% endif %}

                            <h5 class="card-title fw-bold text-dark mb-2">{{ object.title }}</h5>
                            
                            <p class="card-text text-muted small flex-grow-1">
                                {{ object.summary|default:object.content|truncatechars:120 }}
                            </p>

                            <!-- Acciones e indicadores -->
                            <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                {% if detail_url_name %}
                                    <a href="{% url detail_url_name object.pk %}" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        {{ detail_btn_label|default:"Ver Detalle" }} <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                {% endif %}

                                {% if object.pdf_file %}
                                    <a href="{{ object.pdf_file.url }}" target="_blank" class="text-danger fs-5" title="Descargar documento PDF">
                                        <i class="bi bi-file-earmark-pdf-fill"></i>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- Paginación -->
        {% if is_paginated %}
            <nav aria-label="Navegación de páginas" class="mt-5">
                <ul class="pagination justify-content-center">
                    {% if page_obj.has_previous %}
                        <li class="page-item">
                            <a class="page-link rounded-start-pill" href="?page={{ page_obj.previous_page_number }}">Anterior</a>
                        </li>
                    {% else %}
                        <li class="page-item disabled">
                            <span class="page-link rounded-start-pill">Anterior</span>
                        </li>
                    {% endif %}

                    <li class="page-item active">
                        <span class="page-link bg-primary border-primary">
                            Página {{ page_obj.number }} de {{ page_obj.paginator.num_pages }}
                        </span>
                    </li>

                    {% if page_obj.has_next %}
                        <li class="page-item">
                            <a class="page-link rounded-end-pill" href="?page={{ page_obj.next_page_number }}">Siguiente</a>
                        </li>
                    {% else %}
                        <li class="page-item disabled">
                            <span class="page-link rounded-end-pill">Siguiente</span>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}

    {% else %}
        <!-- Estado vacío -->
        <div class="text-center py-5">
            <div class="mb-3 text-muted opacity-50">
                <i class="bi bi-folder2-open display-1"></i>
            </div>
            <h4 class="text-secondary fw-semibold">No hay registros disponibles</h4>
            <p class="text-muted">Pronto se publicará información en esta sección.</p>
        </div>
    {% endif %}
</div>

<style>
.transition-hover {
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
}
.transition-hover:hover {
    transform: translateY(-4px);
    box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
}
</style>
{% endblock %}