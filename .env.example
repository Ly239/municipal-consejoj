# Clave secreta de Django
SECRET_KEY=clave-super-mega-segura-ejemplar

# Modo de depuración (True para desarrollo local, False en producción)
DEBUG=True

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# URL de la base de datos (PostgreSQL o SQLite)
# Ejemplo para PostgreSQL (Render / Supabase / Neon):
DATABASE_URL=postgres://usuario:contradeña@localhost:5432/nombre_basedatos
# Ejemplo para SQLite local:
# DATABASE_URL=sqlite:///db.sqlite3
